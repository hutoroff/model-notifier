  <entry>
    <id>tag:github.com,2008:Repository/307213173/v3.23.0</id>
    <updated>2026-10-01T23:02:59Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/openai/openai-python/releases/tag/v3.23.0"/>
    <title>v3.23.0</title>
    <content type="html">&lt;h2&gt;&lt;a href=&quot;https://github.com/openai/openai-python/compare/v3.22.1...v3.23.0&quot;&gt;3.23.0&lt;/a&gt; (2026-10-01)&lt;/h2&gt;
&lt;h3&gt;Features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;agents:&lt;/strong&gt; [1/n] return typed answers from session streams (&lt;a href=&quot;https://github.com/openai/openai-python/issues/4007&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/4007/hovercard&quot;&gt;#4007&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/10f88169b0f3929b4e2528aad7a825df31163156&quot;&gt;10f8816&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;agents:&lt;/strong&gt; stage files and download turn artifacts (&lt;a href=&quot;https://github.com/openai/openai-python/issues/4009&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/4009/hovercard&quot;&gt;#4009&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/4fc2438ea73f8c1a4802b0cd5ab7607fc3cc1d16&quot;&gt;4fc2438&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; Add session traces and Realtime translations (&lt;a href=&quot;https://github.com/openai/openai-python/issues/4001&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/4001/hovercard&quot;&gt;#4001&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/138e3d14c4bff1322e5c96de711e272bebb77cc2&quot;&gt;138e3d1&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;beta:&lt;/strong&gt; expose typed application actions as agent tools (&lt;a href=&quot;https://github.com/openai/openai-python/issues/4006&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/4006/hovercard&quot;&gt;#4006&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/f219c5581661408688195659ab0137927ba9a033&quot;&gt;f219c55&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;collect final output from beta Agents streams (&lt;a href=&quot;https://github.com/openai/openai-python/commit/157ac4c49a34891d5b66d2950b5082d1b3268315&quot;&gt;157ac4c&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Bug Fixes&lt;/h3&gt;
&lt;ul&gt;
