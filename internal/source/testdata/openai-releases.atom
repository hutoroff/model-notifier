&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add shida to named Live voices (&lt;a href=&quot;https://github.com/openai/openai-python/issues/4053&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/4053/hovercard&quot;&gt;#4053&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/7352cf5c80cf46b0b7c23634fb7df47c28b0604b&quot;&gt;7352cf5&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add vault updates and metadata filters (&lt;a href=&quot;https://github.com/openai/openai-python/issues/4047&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/4047/hovercard&quot;&gt;#4047&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/e72f4931f16ae74602968348461bd3cf50b2cec5&quot;&gt;e72f493&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; align beta pagination limits and non-null parameters (&lt;a href=&quot;https://github.com/openai/openai-python/issues/4057&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/openai/openai-python/pull/4057/hovercard&quot;&gt;#4057&lt;/a&gt;) (&lt;a href=&quot;https://github.com/openai/openai-python/commit/800899eeaf9e2696703452e73a5e95f1a31e12ce&quot;&gt;800899e&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Chores&lt;/h3&gt;
