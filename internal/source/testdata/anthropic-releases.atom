  <entry>
    <id>tag:github.com,2008:Repository/590187800/v1.10.0</id>
    <updated>2026-09-30T18:28:45Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/anthropics/anthropic-sdk-python/releases/tag/v1.10.0"/>
    <title>v1.10.0</title>
    <content type="html">&lt;h2&gt;1.10.0 (2026-09-30)&lt;/h2&gt;
&lt;p&gt;Full Changelog: &lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/compare/v1.9.0...v1.10.0&quot;&gt;v1.9.0...v1.10.0&lt;/a&gt;&lt;/p&gt;
&lt;h3&gt;Features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add a refusal stop reason and stop_details to Managed Agents session idle events (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/cba653fc52ed4a9b57108a0b1ae80d1f51fb46dd&quot;&gt;cba653f&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add Claude Enterprise analytics, spend limits, and RBAC groups and roles to the Admin API (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/6bb2c0ca493168069298a0c6c1740073b564d192&quot;&gt;6bb2c0c&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add per-user usage and cost reports to the Admin API analytics (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/7443920c35d323d887bf908911224c7f2e0d8fde&quot;&gt;7443920&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add Plugins and Plugin Marketplaces to the Admin API (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/1baad3b04df8fc5f1cbcf59bd2eca5e51d88c1e0&quot;&gt;1baad3b&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add repository error types to Managed Agents session errors (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/c682f7e359e3367581a41829fdb51250dd51b0c3&quot;&gt;c682f7e&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; allow removing a plugin&#39;s org-wide installation setting (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/17f52fcde9fec28a2f96e763d9a2217326104fd8&quot;&gt;17f52fc&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; MCP tunnels beta: add read-only &lt;code&gt;transport&lt;/code&gt; object to Tunnel and return the one-time relay &lt;code&gt;token&lt;/code&gt; in the create response (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/88718ff4bdfab22f256b12ec7fdd20509805978c&quot;&gt;88718ff&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; Organization API endpoints are now GA (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/f1d195a6ae90b2b2482b2a6f8f1732d7241b5984&quot;&gt;f1d195a&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Bug Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; make memory store description, metadata, archived_at required (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/6cc39d34e7f3a1ae1eea82fbc634849761966b20&quot;&gt;6cc39d3&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; type admin plugin preference and marketplace fields as enums (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/b4dfd998969d8a23ab7128caa152989aa867c7d2&quot;&gt;b4dfd99&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;credentials:&lt;/strong&gt; refuse config files that group or others can write (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/cd5fc6a1e5a65cbd08f5c77465617526c313f0b8&quot;&gt;cd5fc6a&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;pagination:&lt;/strong&gt; auto-paging continues past an empty page while next_page is set (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/c027a26dd4f33840ea3749db3b3e4059ec749983&quot;&gt;c027a26&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;tools:&lt;/strong&gt; stop the session tool runner after any idle that ends the turn (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/issues/969&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/anthropics/anthropic-sdk-python/pull/969/hovercard&quot;&gt;#969&lt;/a&gt;) (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/9c60a531709471050c084034dece6782cc3298e5&quot;&gt;9c60a53&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Chores&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; update MCP Tunnels types and descriptions (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/aa49ba7fbb56425feebb7c3d0dcc75fd1f109ed4&quot;&gt;aa49ba7&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;ci:&lt;/strong&gt; run tests on the oldest and newest Python in parallel (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/53bb298f0bbed38b60c2b961bd6daf973365b1a1&quot;&gt;53bb298&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;docs:&lt;/strong&gt; remove placeholder enum descriptions (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/f535d6701f65928264cd8fb738e4327fa94fb32c&quot;&gt;f535d67&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;internal:&lt;/strong&gt; format request options with one argument per line (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/4e2463e13499c5e7ba6b2ef389f65b0e8f234350&quot;&gt;4e2463e&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;tests:&lt;/strong&gt; match mocked binary routes when a request adds query params (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/078147029a62d22ea5fe85cf897cfbdc1693b656&quot;&gt;0781470&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;</content>
