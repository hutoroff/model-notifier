  <entry>
    <id>tag:github.com,2008:Repository/590187800/v1.12.0</id>
    <updated>2026-10-07T17:57:07Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/anthropics/anthropic-sdk-python/releases/tag/v1.12.0"/>
    <title>v1.12.0</title>
    <content type="html">&lt;h2&gt;1.12.0 (2026-10-07)&lt;/h2&gt;
&lt;p&gt;Full Changelog: &lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/compare/v1.11.0...v1.12.0&quot;&gt;v1.11.0...v1.12.0&lt;/a&gt;&lt;/p&gt;
&lt;h3&gt;Features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add claude-haiku-5-5 and typed computer and browser toolset tool calls (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/f6346e63b7507a596e6e8acc9425cae2dfc7bf24&quot;&gt;f6346e6&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add disabled to thinking types in model capabilities (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/78d815d78b33cfea5f4aa78c57a30b341fa8ff42&quot;&gt;78d815d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add display_name to RBAC roles and deprecate name (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/f63f99c17583fbdc7e0ba7b92f8f259724403146&quot;&gt;f63f99c&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add include_default parameter to list workspaces (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/5d4b37b36b96e24fb605993216c39db378b14d4c&quot;&gt;5d4b37b&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add lifecycle stage fields and filter to /v1/models (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/0c96c0212f4bfb6f592639c59378583cd80ee352&quot;&gt;0c96c02&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add line to model objects (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/a85c649ff834f54c6809eaceb38e3317c3805fb4&quot;&gt;a85c649&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add url_sources to the Managed Agents web_fetch tool config (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/78d815d78b33cfea5f4aa78c57a30b341fa8ff42&quot;&gt;78d815d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; add web search and code execution support to model capabilities (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/78d815d78b33cfea5f4aa78c57a30b341fa8ff42&quot;&gt;78d815d&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Bug Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; send the beta header by default when listing spend limits (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/e2690b4e733b0453d05bb770f32743618cfc9c92&quot;&gt;e2690b4&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;client:&lt;/strong&gt; send empty strings in query params and multipart forms (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/80e69f1a204bd5bfdd090e6d32ce36c846544c1a&quot;&gt;80e69f1&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;tools:&lt;/strong&gt; keep a local edit made after a memory upload whose response was lost (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/issues/990&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/anthropics/anthropic-sdk-python/pull/990/hovercard&quot;&gt;#990&lt;/a&gt;) (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/78d815d78b33cfea5f4aa78c57a30b341fa8ff42&quot;&gt;78d815d&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Chores&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;client:&lt;/strong&gt; track whether the client timeout was set explicitly (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/36a223feb1cc309bb9e2fcba371b430455a5555a&quot;&gt;36a223f&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;docs:&lt;/strong&gt; correct example groups in rate limit list description (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/71fcf2fbf2caa7b28b228c50b23b94acc78467a9&quot;&gt;71fcf2f&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;docs:&lt;/strong&gt; describe a federation rule&#39;s target by its type (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/78d815d78b33cfea5f4aa78c57a30b341fa8ff42&quot;&gt;78d815d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;docs:&lt;/strong&gt; fix example IDs in sessions, agents and vault credentials (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/78d815d78b33cfea5f4aa78c57a30b341fa8ff42&quot;&gt;78d815d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;docs:&lt;/strong&gt; update Managed Agents multiagent and thread descriptions (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/78d815d78b33cfea5f4aa78c57a30b341fa8ff42&quot;&gt;78d815d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;docs:&lt;/strong&gt; update the activity summaries endpoint description (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/d9bd4bf6f558822e16a2d6a65fd333ee4d3596ab&quot;&gt;d9bd4bf&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;docs:&lt;/strong&gt; update the description of the Model line field (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/4444463ed4f434b248e92c6757b60b8b10a66285&quot;&gt;4444463&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;internal:&lt;/strong&gt; add REVIEW.md with review instructions (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/78d815d78b33cfea5f4aa78c57a30b341fa8ff42&quot;&gt;78d815d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;internal:&lt;/strong&gt; format the code blocks of the docs with one run of ruff (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/78d815d78b33cfea5f4aa78c57a30b341fa8ff42&quot;&gt;78d815d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;internal:&lt;/strong&gt; refactor deprecated models (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/7b0c7d5f4febd73b102559cbf7abcf72ff6ea775&quot;&gt;7b0c7d5&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;tests:&lt;/strong&gt; run tests skipped for a query param bug that is now fixed (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/d6069290e87ef9fba83d232d0fee94528bae1d3c&quot;&gt;d606929&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;tests:&lt;/strong&gt; run tests that an older mock server could not serve (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/bffd22228215ef677530b6cbea5756b7a24203d1&quot;&gt;bffd222&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;tests:&lt;/strong&gt; run the batch results raw and streaming response tests (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/issues/978&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/anthropics/anthropic-sdk-python/pull/978/hovercard&quot;&gt;#978&lt;/a&gt;) (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/78d815d78b33cfea5f4aa78c57a30b341fa8ff42&quot;&gt;78d815d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;tests:&lt;/strong&gt; run the tests skipped for incomplete example responses (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/06a75bc59e17e80de9a7fe95f47faf810b48fa46&quot;&gt;06a75bc&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Documentation&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; state the agent tools limit as 256 (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/e4eff6b3aa651febf5413894a2e220a05aa32c00&quot;&gt;e4eff6b&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;</content>
