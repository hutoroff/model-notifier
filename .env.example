# Bot token from @BotFather (/newbot). Add the bot as an admin of the channel so it can post.
TG_BOT_TOKEN=
# Target chat: @channelname for public channels, or numeric id like -100xxxxxxxxxx for private ones.
TG_CHAT_ID=
# Slack (optional; uncomment the slack notifier in config.yaml): create an app at api.slack.com/apps,
# add the chat:write bot scope, install it, copy the xoxb- Bot User OAuth Token, then /invite the app in the channel.
SLACK_BOT_TOKEN=
# Channel id from channel details (bottom of the About tab), e.g. C0123456789.
SLACK_CHANNEL_ID=
